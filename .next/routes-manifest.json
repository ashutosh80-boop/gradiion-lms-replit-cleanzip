{
  "version": 3,
  "pages404": true,
  "caseSensitive": false,
  "basePath": "",
  "redirects": [
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    }
  ],
  "headers": [],
  "rewrites": {
    "beforeFiles": [],
    "afterFiles": [],
    "fallback": []
  },
  "dynamicRoutes": [],
  "staticRoutes": [
    {
      "page": "/",
      "regex": "^/(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/(?:/)?$"
    },
    {
      "page": "/_not-found",
      "regex": "^/_not\\-found(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/_not\\-found(?:/)?$"
    },
    {
      "page": "/student",
      "regex": "^/student(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/student(?:/)?$"
    },
    {
      "page": "/student/lecture/lecture-2",
      "regex": "^/student/lecture/lecture\\-2(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/student/lecture/lecture\\-2(?:/)?$"
    },
    {
      "page": "/student/module/module-1",
      "regex": "^/student/module/module\\-1(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/student/module/module\\-1(?:/)?$"
    },
    {
      "page": "/student/phase/phase-1a",
      "regex": "^/student/phase/phase\\-1a(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/student/phase/phase\\-1a(?:/)?$"
    },
    {
      "page": "/student/submissions",
      "regex": "^/student/submissions(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/student/submissions(?:/)?$"
    }
  ],
  "dataRoutes": [],
  "rsc": {
    "header": "rsc",
    "varyHeader": "rsc, next-router-state-tree, next-router-prefetch, next-router-segment-prefetch",
    "prefetchHeader": "next-router-prefetch",
    "didPostponeHeader": "x-nextjs-postponed",
    "contentTypeHeader": "text/x-component",
    "suffix": ".rsc",
    "prefetchSuffix": ".prefetch.rsc",
    "prefetchSegmentHeader": "next-router-segment-prefetch",
    "prefetchSegmentSuffix": ".segment.rsc",
    "prefetchSegmentDirSuffix": ".segments"
  },
  "rewriteHeaders": {
    "pathHeader": "x-nextjs-rewritten-path",
    "queryHeader": "x-nextjs-rewritten-query"
  }
}